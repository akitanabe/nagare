services:
    -
        class: Nagare\PHPStan\TransformationDefaultType
    -
        class: Nagare\PHPStan\AdapterReturnTypeExtension
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: Nagare\PHPStan\TerminalReturnTypeExtension
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: Nagare\PHPStan\MaterializationReturnTypeExtension
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: Nagare\PHPStan\ChunkingReturnTypeExtension
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: Nagare\PHPStan\PipelineEachReturnTypeExtension
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: Nagare\PHPStan\TerminalApplyReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
    -
        class: Nagare\PHPStan\TerminalHookReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension
