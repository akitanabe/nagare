{
  "name": "akitanabe/nagare",
  "description": "Declarative iterable processing for PHP using the pipe operator.",
  "type": "library",
  "keywords": [
    "pipe-operator",
    "iterable",
    "pipeline",
    "lazy-evaluation",
    "phpstan"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.5"
  },
  "require-dev": {
    "carthage-software/mago": "^1.48",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "files": [
      "src/functions/adapter.php",
      "src/functions/pipeline.php",
      "src/functions/terminal/aggregation.php",
      "src/functions/terminal/materialization.php",
      "src/functions/terminal/query.php"
    ],
    "psr-4": {
      "Nagare\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Nagare\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "phpstan analyse",
    "test": "phpunit tests",
    "lint": "mago lint",
    "format": "mago format",
    "format:check": "mago format --check",
    "check": [
      "@test",
      "@analyse",
      "@lint",
      "@format:check"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
